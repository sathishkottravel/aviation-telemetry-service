# /opt/infra/.env on the VM (chmod 600). Never commit real values.

# Public hostnames (DNS A records → the VM's public IP).
JAEGER_DOMAIN=jaeger.sathishkottravel.com
OTEL_DOMAIN=otel.sathishkottravel.com

# Bearer token required by otel.* for OTLP ingest. Reuse the token your existing projects already send;
# for a new one: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
OTEL_INGEST_TOKEN=<token>
