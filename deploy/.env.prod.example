# Production settings for /opt/aviation/.env on the VM. This file stays on the VM; never commit real values.
# Generate tokens with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"

LOG_LEVEL=INFO

# MongoDB Atlas (add the VM's public IP under Network Access).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=aviation
TELEMETRY_TTL_DAYS=1

# CloudAMQP (amqps = TLS).
RABBITMQ_URL=amqps://<user>:<password>@<host>/<vhost>

# Public API authentication.
# API_TOKEN: Bearer token for GraphQL (header, or connection_init for subscriptions) and POST /api/telemetry.
# ADMIN_TOKEN: X-Admin-Token for DELETE /api/telemetry. Use two different long random values.
API_TOKEN=<random>
ADMIN_TOKEN=<different-random>

# ADS-B producer.
ADSB_POLL_INTERVAL=10
ADSB_LATITUDE=59.3
ADSB_LONGITUDE=18.0
ADSB_RADIUS_NM=100
ADSB_USER_AGENT=aviation-telemetry-service/0.1 (+https://github.com/sathishkottravel/aviation-telemetry-service)
ADSB_PRODUCER_AIRCRAFT=

# Tracing to the VM's Jaeger over the internal "edge" network (protocol and service names are set in
# docker-compose.prod.yml). Use Jaeger's container name or network alias on "edge".
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
