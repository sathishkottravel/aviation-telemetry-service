# Production settings for /opt/aviation/.env on the VM. This file stays on the VM; never commit real values.
# Generate tokens with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Render does not use this file: its variables are in render.yaml (see deploy/render/README.md).

LOG_LEVEL=INFO

# MongoDB Atlas (add the VM's public IP under Network Access).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=aviation
TELEMETRY_TTL_DAYS=1

# CloudAMQP (amqps = TLS).
RABBITMQ_URL=amqps://<user>:<password>@<host>/<vhost>

# Public API authentication.
# API_TOKEN: Bearer token for GraphQL (header, or connection_init for subscriptions) and POST /api/telemetry.
# ADMIN_TOKEN: X-Admin-Token for DELETE /api/telemetry. Use two different long random values.
API_TOKEN=<random>
ADMIN_TOKEN=<different-random>

# ADS-B producer. The area is the default; requests can pass latitude/longitude/radius to poll elsewhere.
ADSB_POLL_INTERVAL=10
ADSB_LATITUDE=59.3
ADSB_LONGITUDE=18.0
ADSB_RADIUS_NM=100
ADSB_USER_AGENT=aviation-telemetry-service/0.1 (+https://github.com/sathishkottravel/aviation-telemetry-service)
# Comma-separated ICAO hex codes or callsigns (or *) tracked from startup. Atlas and CloudAMQP are shared with the
# Render deployment: only one of the two producers should track a given aircraft.
ADSB_PRODUCER_AIRCRAFT=

# Bearer token for the producer's /ingestion/live/* routes. The VM's producer is only reachable on the compose
# network (the api reaches it as http://producer:8001), so it can stay empty here.
PRODUCER_TOKEN=
# Keep-warm pings for hosts that sleep when idle (Render free tier). Not needed on the VM.
# WAKE_URLS=
# The VM's worker has no HTTP endpoint, so GET /health/all reports it as "not_configured".
# WORKER_URL=
# Browser origins allowed to call the api (CORS), comma-separated. Empty = none.
CORS_ORIGINS=https://sathishkottravel.github.io

# Tracing to the VM's Jaeger container over the shared "edge" network (no token needed internally).
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# To send traces to Grafana Cloud instead: its OTLP gateway as the endpoint, plus URL-encoded auth, e.g.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64 of instanceId:token>
