# The aviation API site. Paste it into the VM's Caddyfile (/etc/caddy/Caddyfile) and reload Caddy.
# Caddy and the backend's api container share the Docker network "edge", where the api is "aviation-api".
# The API itself enforces API_TOKEN (GraphQL, POST /api/telemetry) and X-Admin-Token (DELETE /api/telemetry);
# WebSockets (GraphQL subscriptions) are proxied as-is.

api.sathishkottravel.com {
	reverse_proxy aviation-api:8000
}
