# Copy to .env. These values are for running the services directly on your machine (uv run ...).
# PORT is not set here: hosts such as Render set it. The api then listens on it (default 8000), the producer too
# (default 8001), and the worker opens a /health listener on it (no listener when PORT is unset).

LOG_LEVEL=INFO

# Local MongoDB, or Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=aviation
# MongoDB deletes telemetry older than this (TTL index, applied when the worker starts). 0 = keep forever.
TELEMETRY_TTL_DAYS=1

# Enables DELETE /api/telemetry (send it as X-Admin-Token). Empty = pruning disabled. Use a long random value.
ADMIN_TOKEN=

# Bearer token for GraphQL (header, or connection_init for subscriptions) and POST /api/telemetry. Empty = open.
API_TOKEN=

# Local RabbitMQ, or CloudAMQP: amqps://<user>:<password>@<host>/<vhost>
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_INGEST_EXCHANGE=telemetry.ingest
RABBITMQ_INGEST_QUEUE=telemetry.ingest
RABBITMQ_LIVE_EXCHANGE=telemetry.live

# OpenTelemetry tracing (OTLP/gRPC). Off by default for local runs; docker compose turns it on.
# Local Jaeger: `docker compose up -d jaeger`, then OTEL_ENABLED=true (UI at http://localhost:16686).
# Deployed Jaeger/collector: set the endpoint, e.g. https://<jaeger-host>:4317.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# grpc (Jaeger, Honeycomb) or http/protobuf (HTTP-only gateways such as Grafana Cloud).
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# Auth for hosted backends, URL-encoded (space = %20), e.g. Authorization=Basic%20<base64 of instanceId:token>
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_SERVICE_NAME defaults to flight-telemetry-api / flight-telemetry-worker / flight-telemetry-producer.

# API -> ADS-B producer (trackableAircraft, trackingStatus, startTracking/stopTracking)
PRODUCER_URL=http://localhost:8001
# Bearer token the producer requires on /ingestion/live/*; the api sends it. Both read it, so use the same value.
# Empty = open. Set it wherever the producer is publicly reachable (Render). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PRODUCER_TOKEN=
# URLs the api pings on startup and every 10 minutes, so hosts that sleep when idle (Render free tier) stay awake
# while the api is in use. Comma-separated. Empty = off.
# WAKE_URLS=https://<producer>.onrender.com/health,https://<worker>.onrender.com/health

# ADS-B producer (ADSB.lol). Polls a circle around the given point.
ADSB_BASE_URL=https://api.adsb.lol
ADSB_POLL_INTERVAL=5
ADSB_LATITUDE=59.3
ADSB_LONGITUDE=18.0
ADSB_RADIUS_NM=100
ADSB_REQUEST_TIMEOUT=10
# ADSB.lol returns 403 for generic User-Agents; identify the app and a contact URL.
ADSB_USER_AGENT=aviation-telemetry-service/0.1 (+https://github.com/<you>/aviation-telemetry-service)
# Comma-separated ICAO hex codes or callsigns tracked from startup, e.g. 4ca7b1,SAS123. Empty = none.
ADSB_PRODUCER_AIRCRAFT=

# docker compose only (the containers ignore the values above for these settings):
# COMPOSE_OTEL_ENABLED=false   # turn tracing off in the containers (default: on)
# COMPOSE_OTEL_EXPORTER_OTLP_ENDPOINT=https://<jaeger-host>:4317   # containers' OTLP endpoint (default: bundled jaeger)
# COMPOSE_OTEL_TRACES_EXPORTER=otlp   # passed to the containers as OTEL_TRACES_EXPORTER (default: otlp)
# Grafana Cloud from the containers (endpoint, instance ID and token: Grafana Cloud portal -> OpenTelemetry tile):
# COMPOSE_OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# COMPOSE_OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
# COMPOSE_OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<output of: printf '%s' '<instance-id>:<token>' | base64>
# MongoDB URI for the containers (default: the bundled mongo service), e.g. Atlas:
# COMPOSE_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
